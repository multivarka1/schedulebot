BOT_TOKEN=
BOT_USERNAME=maxscheduleetu_bot
INSTITUTION_ID=75
# Строка init_data из мини-приложения расписания MAX.
# Без неё API может отвечать 401 Unauthorized.
MAX_INIT_DATA=
# Необязательно: временный auth_token, если он уже получен вручную.
SCHEDULE_AUTH_TOKEN=
# Файл сессии создаётся автоматически и сохраняет refresh_token между перезапусками.
SCHEDULE_SESSION_FILE=schedule_session.json
# 0 — безопасный режим: обновлять только после ответа API 401.
# Положительное значение включает принудительный периодический refresh.
SESSION_REFRESH_INTERVAL_MINUTES=0
# Случайное отклонение в процентах: 20 означает примерно 8–12 минут.
SESSION_REFRESH_JITTER_PERCENT=20
ABC=